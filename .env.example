# ============================================
# Zalogram Backend — Environment Variables
# ============================================
# Copy file này thành .env và điền giá trị thực

# --- Server ---
NODE_ENV=development
PORT=3000
API_VERSION=v1

# --- JWT (RS256) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/facebook/callback

# --- AWS ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- DynamoDB ---
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=Zalogram_

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=zalogram-backend
KAFKA_GROUP_ID=zalogram-consumer-group

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- AWS S3 ---
S3_BUCKET_NAME=zalogram-media
S3_REGION=ap-southeast-1
CLOUDFRONT_DOMAIN=

# --- AWS SES ---
SES_FROM_EMAIL=noreply@zalogram.vn
SES_REGION=ap-southeast-1

# --- AWS SNS ---
SNS_REGION=ap-southeast-1

# --- Google Gemini AI ---
GOOGLE_GEMINI_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
