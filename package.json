{
  "name": "zalogram-backend",
  "version": "1.0.0",
  "description": "Zalogram OTT Backend — Node.js + Express + TypeScript (Monolithic)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "start": "node -r module-alias/register dist/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{cjs,json}\"",
    "typecheck": "tsc --noEmit",
    "db:wait": "tsx scripts/database/wait-for-dynamodb.ts",
    "es:wait": "tsx scripts/database/wait-for-elasticsearch.ts",
    "es:seed:analytics": "tsx scripts/database/seed-analytics-es.ts --",
    "es:sync:users": "tsx scripts/database/sync-users-to-es.ts",
    "db:setup": "tsx scripts/database/setup-database.ts",
    "db:migrate": "tsx scripts/database/run-migrations.ts",
    "db:migrate:dist": "node dist/scripts/database/run-migrations.js",
    "db:seed": "tsx scripts/database/insert-data.ts",
    "db:seed:file": "tsx scripts/database/insert-data.ts --file",
    "db:seed:media": "tsx scripts/database/insert-data.ts --file Media",
    "db:seed:users": "tsx scripts/database/insert-data.ts --file Users",
    "db:seed:messages": "tsx scripts/database/insert-data.ts --file Messages",
    "db:seed:posts": "tsx scripts/database/insert-data.ts --file Posts",
    "db:seed:reels": "tsx scripts/database/insert-data.ts --file Reels",
    "db:seed:admin-demo": "tsx scripts/database/insert-data.ts --file Media && tsx scripts/database/insert-data.ts --file Users && tsx scripts/database/insert-data.ts --file Messages && tsx scripts/database/insert-data.ts --file Posts && tsx scripts/database/insert-data.ts --file Reels",
    "db:reset": "tsx scripts/database/setup-database.ts && tsx scripts/database/insert-data.ts",
    "db:seed:legacy": "tsx scripts/database/seed-data.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1037.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-rekognition": "^3.1027.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/cloudfront-signer": "^3.1036.0",
    "@aws-sdk/lib-dynamodb": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@elastic/elasticsearch": "^8.14.0",
    "@google/generative-ai": "^0.12.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "agora-token": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.3.1",
    "file-type": "^19.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/passport": "^1.0.16",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "_moduleAliases": {
    "@": "dist",
    "@config": "dist/config",
    "@modules": "dist/modules",
    "@shared": "dist/shared"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
